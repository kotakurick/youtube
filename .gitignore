# 大きいファイルの既定の置き場（YT_DATA_DIR 未設定時）
_local/

# 動画・音声（Gitの外に置く）
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.flac

# 画像はGitの外に置く（自作のSVG素材は assets/ で管理）
*.jpg
*.jpeg
*.png
*.webp
!assets/**/*.png

# 認証情報（キーは ~/.youtube_api_key や環境変数に置き、リポジトリに入れない）
.env
.env.*
*.key
*credentials*.json
client_secret*.json

# 字幕・メタデータの取得物
*.vtt
*.info.json

# ツール・OS
node_modules/
__pycache__/
.venv/
.DS_Store
Thumbs.db
